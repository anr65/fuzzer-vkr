{
  "name": "nikic/php-fuzzer",
  "license": "MIT",
  "require": {
    "php": "^8.2|^8.3|^8.4",
    "fruitcake/php-cors": "^1.3",
    "laravel/laravel": "^12.0",
    "nikic/php-parser": "^5.0",
    "nikic/include-interceptor": "^0.1.1",
    "ulrichsg/getopt-php": "^4.0",
    "ext-json": "*",
    "symfony/yaml": "^7.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^9",
    "phpstan/phpstan": "^1.10"
  },
  "suggest": {
    "ext-pcntl": "Needed for timeout support"
  },
  "autoload": {
    "psr-4": {
      "PhpFuzzer\\": "src/"
    }
  },
  "bin": ["bin/php-fuzzer"]
}
